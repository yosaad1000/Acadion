# Example Terraform variables for AWS Free Tier Deployment
# Copy this file to terraform.tfvars and update with your values

# Basic Configuration
aws_region     = "us-east-1"
environment    = "prod"
project_name   = "acadion"

# Network Configuration
vpc_cidr = "10.0.0.0/16"

# Security Configuration (restrict these in production)
allowed_ssh_cidrs  = ["0.0.0.0/0"]  # Replace with your IP: ["YOUR_IP/32"]
allowed_http_cidrs = ["0.0.0.0/0"]

# SSH Key Pair (optional - for EC2 access)
key_pair_name = "acadion-keypair"

# Supabase Configuration (required)
supabase_url         = "https://your-project.supabase.co"
supabase_service_key = "your-supabase-service-key"

# Pinecone Configuration (required for face recognition)
pinecone_api_key = "your-pinecone-api-key"

# JWT Secret (generate a secure random string)
jwt_secret_key = "your-jwt-secret-key-here"

# GitHub Repository for CI/CD (format: owner/repo)
github_repository = "your-username/acadion"

# Monitoring and Backup
enable_detailed_monitoring = false  # Keep false for free tier
auto_scaling_enabled      = false  # Keep false for free tier
backup_retention_days     = 7

# Cost Controls
# These help stay within free tier limits
# EC2: 750 hours/month (t2.micro)
# Lambda: 1M requests + 400,000 GB-seconds
# S3: 5GB storage + 20,000 GET + 2,000 PUT
# Data Transfer: 15GB/month outbound