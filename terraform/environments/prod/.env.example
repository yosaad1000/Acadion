# Production Environment Variables for Terraform
# Copy this file to .env and fill in the actual values
# DO NOT commit the .env file to version control

# AWS Configuration
export AWS_REGION=us-east-1
export AWS_PROFILE=default

# JWT Configuration
export TF_VAR_jwt_secret_key="your-production-jwt-secret-key-32-chars-min"
export TF_VAR_encryption_key="your-production-encryption-key-32-chars"

# Supabase Configuration
export TF_VAR_supabase_url="https://your-production-project.supabase.co"
export TF_VAR_supabase_key="your-production-supabase-anon-key"
export TF_VAR_supabase_service_key="your-production-supabase-service-key"

# Pinecone Configuration
export TF_VAR_pinecone_api_key="your-pinecone-api-key"
export TF_VAR_pinecone_environment="us-east-1-aws"
export TF_VAR_pinecone_index_name="acadion-faces-prod"

# GitHub Configuration
export TF_VAR_github_repository="your-org/acadion"
export TF_VAR_github_actions_role_arn=""

# CloudFront Configuration (optional)
export TF_VAR_cloudfront_domain="acadion.com"

# Monitoring Configuration
export TF_VAR_alert_email_addresses='["admin@acadion.com","devops@acadion.com"]'
export TF_VAR_backup_notification_emails='["backup@acadion.com"]'
export TF_VAR_critical_alert_email_addresses='["critical@acadion.com"]'

# Terraform State Configuration (for remote state)
export TF_VAR_terraform_state_bucket="acadion-terraform-state-prod"