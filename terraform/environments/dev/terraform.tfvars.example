# Example Terraform variables for development environment
# Copy this file to terraform.tfvars and update with your values

# Basic Configuration
aws_region   = "us-east-1"
environment  = "dev"
project_name = "acadion"

# GitHub Configuration
github_repository = "your-org/acadion"

# ECS Configuration
ecs_cluster_name = "acadion-dev-cluster"

# Resource Configuration
backend_cpu                = 512
backend_memory            = 1024
frontend_cpu              = 256
frontend_memory           = 512
face_recognition_cpu      = 1024
face_recognition_memory   = 2048

# ElastiCache Configuration
redis_node_type         = "cache.r6g.large"
redis_num_cache_nodes   = 1  # Single node for dev

# Monitoring Configuration
alert_email_addresses = [
  "devops@yourcompany.com",
  "alerts@yourcompany.com"
]
critical_alert_email_addresses = [
  "oncall@yourcompany.com",
  "manager@yourcompany.com"
]
slack_webhook_url              = "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"
log_retention_days             = 7  # Shorter retention for dev
enable_lambda_alert_processor  = true

# Monitoring Thresholds (more relaxed for dev)
cpu_threshold                      = 85
memory_threshold                   = 90
response_time_threshold            = 3
error_rate_threshold               = 20
face_recognition_queue_threshold   = 100

# Application Configuration
log_level    = "DEBUG"
debug_mode   = "true"
cors_origins = "*"

# Face Recognition Configuration
face_threshold           = "0.6"
max_faces_per_image     = "20"
face_processing_timeout = "30"

# Cache Configuration
cache_ttl_default  = "1800"  # 30 minutes for dev
cache_ttl_sessions = "900"   # 15 minutes for dev

# Security Configuration (use secure values in production)
jwt_secret_key       = "your-jwt-secret-key-here"
encryption_key       = "your-encryption-key-here"
supabase_url         = "https://your-project.supabase.co"
supabase_key         = "your-supabase-anon-key"
supabase_service_key = "your-supabase-service-key"
pinecone_api_key     = "your-pinecone-api-key"
pinecone_environment = "us-east-1-aws"
pinecone_index_name  = "acadion-faces-dev"

# IAM Configuration
create_github_actions_role = true