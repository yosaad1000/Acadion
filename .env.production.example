# Production Environment Variables for Attendify
# Copy this file to .env and fill in your actual values

# Docker Configuration
DOCKER_USERNAME=justs44d
VERSION=latest

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password

# Supabase Configuration (Required)
# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# JWT Configuration
SECRET_KEY=your-super-secret-jwt-key-min-32-characters

# Pinecone Configuration (for AI features)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=attendify-faces

# Face Recognition Configuration
FACE_THRESHOLD=0.6

# Application Configuration
ENVIRONMENT=production
DOCKER_ENV=true

# Optional: SSL Configuration (if using HTTPS)
# SSL_CERT_PATH=/path/to/your/cert.pem
# SSL_KEY_PATH=/path/to/your/key.pem